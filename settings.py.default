# Настройки бота
# Скопируйте этот файл в settings.py и укажите ваш токен бота

# Токен бота от @BotFather
local_token = "YOUR_BOT_TOKEN_HERE"
production_token = ""

RUN_ON_PRODUCTION = False

if RUN_ON_PRODUCTION:
    DB_USER = "test"
    DB_PASSWORD = ""
    DB_HOST = ""
    DB_NAME = "pizdabot_db"
    token = production_token
else:
    DB_USER = "test"
    DB_PASSWORD = ""
    DB_HOST = ""
    DB_NAME = "pizdabot_db"
    token = local_token

# URL базы данных (например, SQLite, PostgreSQL)
DATABASE_URL = f"mysql+pymysql://{DB_USER}:{DB_PASSWORD}@{DB_HOST}/{DB_NAME}?charset=utf8mb4"

# список логинов Администраторов
ADMIN_USERNAMES = []
