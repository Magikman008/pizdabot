# settings.py.default

# Настройки бота
local_token = "YOUR_BOT_TOKEN_HERE"
production_token = ""

RUN_ON_PRODUCTION = False

if RUN_ON_PRODUCTION:
    DB_USER = "test"
    DB_PASSWORD = ""
    DB_HOST = ""
    DB_NAME = "pizdabot_db"
    token = production_token
else:
    DB_USER = "test"
    DB_PASSWORD = ""
    DB_HOST = ""
    DB_NAME = "pizdabot_db"
    token = local_token

# Убираем старую переменную yookassa_token
# Она больше не нужна, так как для ЮКассы используется прямой API

DATABASE_URL = f"mysql+pymysql://{DB_USER}:{DB_PASSWORD}@{DB_HOST}/{DB_NAME}?charset=utf8mb4"

ADMIN_USERNAMES = []
